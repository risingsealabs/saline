cabal-version:      3.0
name:               frontend
version:            0.1
build-type:         Simple
license:            Apache-2.0
license-file:       LICENSE
author:             Rising Sea Labs Ltd.
maintainer:         code@risingsealabs.com
copyright:          2024 Rising Sea Labs Ltd.

common ghc2021
  default-language: Haskell2010
  default-extensions:
    BangPatterns
    BinaryLiterals
    ConstraintKinds
    DeriveDataTypeable
    DeriveGeneric
    DeriveLift
    DeriveTraversable
    DoAndIfThenElse
    EmptyCase
    EmptyDataDecls
    EmptyDataDeriving
    ExistentialQuantification
    FlexibleContexts
    FlexibleInstances
    ForeignFunctionInterface
    GADTSyntax
    GeneralisedNewtypeDeriving
    HexFloatLiterals
    ImportQualifiedPost
    InstanceSigs
    MonoLocalBinds
    MultiParamTypeClasses
    NamedFieldPuns
    NamedWildCards
    NumericUnderscores
    PatternGuards
    PolyKinds
    PostfixOperators
    RankNTypes
    RelaxedPolyRec
    ScopedTypeVariables
    StandaloneDeriving
    StandaloneKindSignatures
    StarIsType
    TraditionalRecordSyntax
    TupleSections
    TypeApplications
    TypeOperators

common ghc2024
  import: ghc2021
  default-extensions:
    DataKinds
    DerivingStrategies
    DisambiguateRecordFields
    GADTs
    LambdaCase
    RoleAnnotations

common defaults
  import: ghc2024
  ghc-options:
    -Wall -O -fno-show-valid-hole-fits
    -- unsafe code
    -Wincomplete-record-updates -Wincomplete-uni-patterns -Wpartial-fields
    -- unneeded code
    -Widentities -Wredundant-constraints

    -Werror=incomplete-patterns
    -Werror=missing-fields
    -Werror=missing-methods

    -ferror-spans
    -fprint-expanded-synonyms

  if impl(ghc >= 8.8)
    ghc-options:
      -Wmissing-deriving-strategies

library
  import: defaults
  hs-source-dirs: src
  build-depends:
      aeson
    , base
    , bytestring
    , categories
    , clay
    , common
    , containers
    , containers
    , crypton
    , dependent-map
    , dependent-sum
    , distributive
    , errors
    , ghcjs-dom
    , hs-abci-types
    , hs-tendermint-client
    , jsaddle
    , lens
    , memory
    , modern-uri
    , mtl
    , obelisk-executable-config-lookup
    , obelisk-frontend
    , obelisk-generated-static
    , obelisk-route
    , QuickCheck
    , reflex-dom-core
    -- ^ https://github.com/obsidiansystems/obelisk/pull/606
    , semialign
    , text
    , these
    , time
    , transformers
    , universe
    , universe-some
    , witherable

  exposed-modules:
    Frontend
    Saline.App
    Saline.App.Assets
    Saline.App.Editor.Diagrams
    Saline.App.Editor.Field
    Saline.App.Editor.Intents.Editor
    Saline.App.Editor.Main
    Saline.App.Editor.PrettyPrint
    Saline.App.Editor.Render
    Saline.App.Editor.Scenario
    Saline.App.Editor.Utils.Editor
    Saline.App.Editor.Utils.Reflex
    Saline.App.Editor.Utils.Reflex.Dom
    Saline.App.Editor.Widgets
    Saline.App.Environment
    Saline.App.Explorer
    Saline.App.Hardcoded
    Saline.App.Layout
    Saline.App.Storage
    Saline.App.Tailwind
    Saline.App.Utils
    Saline.App.Wallet
    Saline.App.Wallet.PasswordUtils
    Saline.App.Wallet.Setup
    Saline.App.Widgets

executable frontend
  -- TODO: make 'import' work on android
  -- reflex-platform does highly fragile sed which makes 'import' not the first statement and thus dropped
  -- https://github.com/reflex-frp/reflex-platform/blob/3e19e6443c6f7bf5a004aad1adbc3326c142174b/android/impl.nix#L6
  import: defaults
  main-is: main.hs
  hs-source-dirs: src-bin
  build-depends:
      base
    , common
    , frontend
    , obelisk-frontend
    , obelisk-route
    , reflex-dom
    , text

  if impl(ghcjs)
    ghc-options: -dedupe
    cpp-options: -DGHCJS_BROWSER
  if os(darwin)
    ghc-options:
     -- frontend: user error (RTS doesn't support multiple OS threads (use ghc -threaded when linking))
      -threaded

      -- TODO: is this still needed? https://github.com/reflex-frp/reflex-platform/blob/develop/notes/macOS.md
      -dynamic
